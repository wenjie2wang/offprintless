(common) {
	root * /i-librarian/public

	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	php_fastcgi unix//run/php/php8.1-fpm.sock {
		# Forward headers.
		header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
		# php.ini settings
		# Uploads are sent one file per request, so post_max_size only needs headroom over one file.
		# The largest PDF in the current library is 37 MB. Time is raised for large files, slow links and long
		# BibTeX/RIS imports; max_file_uploads covers dropping many files on a multi-file form.
		env PHP_VALUE "upload_max_filesize=100M
		post_max_size=120M
		max_file_uploads=200
		max_execution_time=300
		max_input_time=300
		max_input_vars=10000"
	}

	respond /.* 403
}

:80 {
	log {
		output stdout
		format json
	}

	handle /library* {
		uri strip_prefix /library
		import common
	}

	handle {
		import common
	}

	respond 404
}